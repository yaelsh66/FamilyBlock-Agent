# Backend API origin used by the Windows agent.
# Use the same base URL as VITE_BACKEND_URL in the frontend.
# Local example: http://localhost:8081
# Production example: https://your-backend.onrender.com
FAMILYBLOCK_BACKEND_URL=http://localhost:8081

# Optional fallback if FAMILYBLOCK_BACKEND_URL is not set.
BACKEND_HOST=localhost
BACKEND_PORT=8081
BACKEND_USE_SSL=false

# Device credentials created in the parent UI when adding a device.
# These can also live in config.json instead of environment variables.
DEVICE_ID=
DEVICE_SECRET=

# Local config file path used by the Windows service.
FAMILYBLOCK_CONFIG_PATH=C:\FamilyBlockService\config.json
